   "text": "the cancellation:  (-1 / p_on) x p_on (delta - p_i)  =  p_i - delta",
   "originalText": "the cancellation:  (-1 / p_on) x p_on (delta - p_i)  =  p_i - delta",
   "fontSize": 22.0,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 20
  },
  {
   "id": "e115",
   "type": "text",
   "x": 62,
   "y": 1603.1,
   "width": 684.8,
   "height": 23.8,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 540844173,
   "version": 1,
   "versionNonce": 1062160344,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "customData": {
    "panel": "chain"
   },
   "text": "the 1/p_on from the log meets the p_on from softmax and they cancel.",
   "originalText": "the 1/p_on from the log meets the p_on from softmax and they cancel.",
   "fontSize": 19.0,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "id": "e116",
   "type": "text",
   "x": 62,
   "y": 1631.1,
   "width": 996.9,
   "height": 23.8,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 98591890,
   "version": 1,
   "versionNonce": 921463034,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "customData": {
    "panel": "chain"
   },
   "text": "delta is 1 at the right answer and 0 elsewhere, so what's left is p, with 1 taken off at on: p - y.",
   "originalText": "delta is 1 at the right answer and 0 elsewhere, so what's left is p, with 1 taken off at on: p - y.",
